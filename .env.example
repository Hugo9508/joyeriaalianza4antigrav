# WooCommerce REST API — joyeriabd.a380.com.br
WOO_BASE_URL=https://joyeriabd.a380.com.br
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Chat "Alma" — OpenAI directo
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — Supabase → Project Settings → API. NUNCA es la anon key,
# y nunca debe tener el prefijo NEXT_PUBLIC_. Solo la usan las rutas API server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Webhooks n8n (checkout / eventos)
N8N_WEBHOOK_TOKEN=
N8N_CHECKOUT_WEBHOOK_URL=https://n8n.axion380.com.br/webhook/ja-checkout
N8N_WEBHOOK_SECRET=

# Otros
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
MAINTENANCE_MODE=false
